@apiUrl = http://127.0.0.1:3000/api/v1


### get all cats
GET {{apiUrl}}/cats

#### get cat by id
GET {{apiUrl}}/cats/1

#### delete cat by id
DELETE {{apiUrl}}/cats/1

### get cat by id not found
GET {{apiUrl}}/cats/999

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_id": 4,
    "name": "Mittens",
    "age": 2,
    "birthdate": "2021-05-15",
    "weight": 4.5,
    "owner": "Kimberly",
    "image": "https://placecats.com/300/200"
}

### edit existing cat
PUT {{apiUrl}}/cats/3
Content-Type: application/json

{
    "weight": 5.0,
    "owner": "Kimberly Smith"
}
