@apiUrl = http://127.0.0.1:3000/api/v1

#### ---CATS---
### get all cats
GET {{apiUrl}}/cats

#### get cat by id
GET {{apiUrl}}/cats/1

#### delete cat by id
DELETE {{apiUrl}}/cats/1

### get cat by id not found
GET {{apiUrl}}/cats/999

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_id": 4,
    "name": "Mittens",
    "age": 2,
    "birthdate": "2021-05-15",
    "weight": 4.5,
    "owner": "Kimberly",
    "image": "https://placecats.com/300/200"
}

### edit existing cat
PUT {{apiUrl}}/cats/59
Content-Type: application/json

{
    "weight": 5.0,
    "cat_name": "Whiskers"
}

### post cat with image
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

37
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### delete cat by id
DELETE {{apiUrl}}/cats/58


### ---USERS---
### get all users
GET {{apiUrl}}/users

#### get user by id
GET {{apiUrl}}/users/3609

#### delete user by id
DELETE {{apiUrl}}/users/3609

### get user by id not found
GET {{apiUrl}}/users/999

### post new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Kissa koira",
    "username": "kissa_koira",
    "email": "kissa.koira@example.com",
    "role": "user",
    "password": "password123"
}

### edit existing user
PUT {{apiUrl}}/users/3609
Content-Type: application/json

{
    "username": "mikko_koira",
    "email": "mikko.koira@example.com",
    "role": "admin"
}

### cats of a user
GET {{apiUrl}}/users/37/cats
